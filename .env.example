# 后端端口（Node Express + ws）
PORT=3001

# FlashHead 数字人推理模式（只支持本地推理；已移除 2d 可选模式与云端 WaveSpeed 模式）：
#   gradio —— 连接本地已运行的 SoulX FlashHead Gradio 服务（FLASHHEAD_URL，流式推理端点 /run_inference_streaming）【默认，推荐】
#   local  —— 连接本地 FastAPI 推理服务（FLASHHEAD_URL，ws:// 协议）
# 若探测本地服务失败，后端自动降级为实时语音播放（2d，不等待视频）。
FLASHHEAD_MODE=gradio

# 本地 FlashHead 推理服务地址（gradio / local 模式时生效）
FLASHHEAD_URL=http://127.0.0.1:6006

# 本地推理服务探测超时（毫秒，默认 10000；连不上则直接实时播放语音，不等待视频）
FLASHHEAD_TIMEOUT=10000

# 音频优先级（默认 true=以数字人视频音轨为准，视频带声时仅播视频音、不重复播报；
# false=以原始 TTS 为准，数字人视频强制静音，始终用原始语音播报，避免与视频音轨双声）。
# 后端默认值，用户可在设置页本地覆盖（localStorage，无需重启）。
FLASHHEAD_AUDIO_SYNC=true

# WaveSpeed 云 API 已弃用（云端模式已移除），无需配置

# 虾哥云（小智公共服）OTA 注册与 WebSocket 地址（一般无需修改）
XIAOZHI_OTA_URL=https://api.tenclass.net/xiaozhi/ota/
XIAOZHI_WS_URL=wss://api.tenclass.net/xiaozhi/v1/
